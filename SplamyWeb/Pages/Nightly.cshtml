@page
@using SplamyWeb.Pages
@model NightlyModel
@{
	ViewData["Title"] = "Nightly";
	ViewData["Header"] = "Nightly Builds";
	Layout = "~/Pages/_Layout.cshtml";
}
@foreach (var project in this.Model.GetNightlyProjects())
{
	<h3 id="@project.Id">@(project.ProjectName ?? "<unnamed>"):</h3>
	var isExtended = await Html.ViewData.Model.IsExtented();
	<table class="dltable">
		<tr>
			<th>Branch</th>
			<th>Version</th>
			<th>Commit</th>
			<th>Date</th>
			<th>Link</th>
			@if (isExtended)
			{
				<th>Count</th>
				<th>Options</th>
			}
		</tr>
		@foreach (var (entry, active) in this.Model.GetActives(project.Id, isExtended))
		{
			<tr>
				<td>@entry.Branch</td>
				<td>@entry?.Version</td>
				<td>@entry?.Commit.Substring(0, 8)</td>
				<td>@entry?.UploadTime</td>
				@if (active)
				{
					<td><a href="~/api/nightly/@project.Id/@entry.Branch/download" download="@entry.FileName" class="dllink">Download</a></td>
				}
				else
				{
					<td></td>
				}
				@if (isExtended)
				{
					<td>@entry.DownloadCount</td>
					@if (active)
					{
						<td><a class="dllink" onclick="ask_delete_nightly('@project.Id', '@entry.Branch')">X</a></td>
					}
					else
					{
						<td></td>
					}
				}
			</tr>
		}
	</table>
}
