@page
@using System
@using SplamyWeb
@using SplamyWeb.Pages
@model NightlyModel
@{
	ViewData["Title"] = "Nightly";
	ViewData["Header"] = "Nightly Builds";
	Layout = "~/Pages/_Layout.cshtml";
}
@foreach (var project in Model.GetNightlyProjects())
{
	<div class="box">
		<h2 id="@project.Id" class="is-size-4">@(project.ProjectName ?? "<unnamed>"):</h2>
		@if (project.Id == "ts3ab")
		{
			<div class="notification is-warning">
				All builds starting with 0.12.* on develop are for dotnet core 3.1 only. Mono and dotnet core 2.2 are not supported anymore.
			</div>
		}
		@{var isExtended = await Model.IsExtented(); }
		<table class="table" style="width:100%;">
			<tr>
				<th>Branch</th>
				<th>Version</th>
				<th>Commit</th>
				<th>Date</th>
				<th>Link</th>
				@if (isExtended)
				{
					<th>Count</th>
					<th>Options</th>
				}
			</tr>
			@foreach (var (entry, active) in Model.GetActives(project.Id, isExtended))
			{
				<tr>
					<td>@entry.Branch</td>
					<td>@entry.Version</td>
					<td style="text-transform: uppercase;">
						@{ var com = entry.Commit.Truncate(8); }
						@if (project.CommitUrl != null && project.CommitUrl.Contains("{0}"))
						{
							<a href="@string.Format(project.CommitUrl, entry.Commit)">@com</a>
						}
						else
						{
							@com;
						}
					</td>
					<td>@entry.UploadTime</td>
					<td>
						@if (active)
						{
							<a href="~/api/nightly/@project.Id/@entry.Branch/download"
							   download="@entry.FileName"
							   class="button is-primary is-rounded is-small">
								Download
							</a>
						}
					</td>
					@if (isExtended)
					{
						<td>@entry.DownloadCount</td>
						<td>
							@if (active)
							{
								<button class="button is-primary is-tool is-small compact"
										onclick="ask_delete_nightly('@project.Id', '@entry.Branch')">
									<span class="icon">
										<i class="mdi mdi-close mdi-24px"></i>
									</span>
								</button>
							}
						</td>
					}
				</tr>
			}
		</table>
	</div>
}
