@page
@using System
@using SplamyWeb
@using SplamyWeb.Pages
@model NightlyModel
@{
	ViewData["Title"] = "Nightly";
	ViewData["Header"] = "Nightly Builds";
	Layout = "~/Pages/_Layout.cshtml";
}
@{var isExtended = await Model.IsExtented(); }
@await foreach (var (project, builds) in Model.GetNightlyProjects(isExtended))
{
	<div class="box">
		<h2 id="@project.Project" class="is-size-4">@(project.ProjectName ?? "<unnamed>"):</h2>
		@{var notification = await Model.TryFetchNotification(project.Project); }
		@Html.Raw(notification)
		<table class="table" style="width:100%;">
			<tr>
				<th>Branch</th>
				<th>Version</th>
				<th>Commit</th>
				<th>Date</th>
				<th>Link</th>
				@if (isExtended)
				{
					<th>Count</th>
					<th>Options</th>
				}
			</tr>
			@foreach (var (entry, active) in builds)
			{
				<tr>
					<td>@entry.Branch</td>
					<td>@entry.Version</td>
					<td style="text-transform: uppercase;">
						@{ var com = entry.Commit.Truncate(8); }
						@if (project.CommitUrl != null && project.CommitUrl.Contains("{0}"))
						{
							<a href="@string.Format(project.CommitUrl, entry.Commit)">@com</a>
						}
						else
						{
							@com;
						}
					</td>
					<td>@entry.UploadTime</td>
					<td>
						@if (active)
						{
							<a href="~/api/nightly/@project.Project/@entry.Branch/download"
							   download="@entry.FileName"
							   class="button is-primary is-rounded is-small">
								Download
							</a>
						}
					</td>
					@if (isExtended)
					{
						<td>@entry.DownloadCount</td>
						<td>
							@if (active)
							{
								<button class="button is-primary is-tool is-small compact"
										onclick="Nightly.askDeleteNightly('@project.Project', '@entry.Branch')">
									<span class="icon">
										<i class="mdi mdi-close mdi-24px"></i>
									</span>
								</button>
							}
						</td>
					}
				</tr>
			}
		</table>
	</div>
}

@section scripts
{
	<script src="~/js/Nightly.js"></script>
}
