@page
@model SplamyWeb.StatsModel
@{
	ViewData["Title"] = "TSAudioBot Stats";
	Layout = "~/Pages/_Layout.cshtml";
}

<script>
	window.onload = async function () {
		const ctx = document.getElementById('tsab_graph').getContext('2d');
		const response = await fetch("/api/tab/stats/graph");
		const data = await response.json();

		function cjsd(date) { return moment(date).valueOf(); }

		const mappedRunningInstances = data.map(x => {
			return { t: cjsd(x.date), y: x.runningInstances };
		});
		const mappedRunningBots = data.map(x => {
			return { t: cjsd(x.date), y: x.runningBots };
		});
		const mappedPlayTime = data.map(x => {
			return { t: cjsd(x.date), y: Number(x.playbackTime.totalDays.toFixed(1)) };
		});

		const c_red = 'rgb(255, 99, 132)';
		const c_yellow = 'rgb(255, 205, 86)';
		const c_green = 'rgb(75, 192, 192)';

		const config = {
			type: 'line',
			data: {
				datasets: [{
					label: 'Instances',
					backgroundColor: c_red,
					borderColor: c_red,
					data: mappedRunningInstances,
					fill: false,
					yAxisID: 'y-axis-count',
				},
				{
					label: 'Bots',
					backgroundColor: c_yellow,
					borderColor: c_yellow,
					data: mappedRunningBots,
					fill: false,
					yAxisID: 'y-axis-count',
				},
				{
					label: 'Playtime (Days)',
					type: 'bar',
					backgroundColor: c_green,
					borderColor: c_green,
					data: mappedPlayTime,
					fill: false,
					yAxisID: 'y-axis-time',
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				aspectRatio: 2,
				tooltips: {
					mode: 'index',
					intersect: false
				},
				hover: {
					mode: 'index',
					intersect: false
				},
				title: {
					display: false,
					text: 'TS3AudioBot Stats'
				},
				scales: {
					yAxes: [{
						display: true,
						scaleLabel: {
							display: true,
							labelString: 'Count'
						},
						id: 'y-axis-count'
					},
					{
						display: true,
						scaleLabel: {
							display: true,
							labelString: 'Time'
						},
						gridLines: {
							drawOnChartArea: false, // only want the grid lines for one axis to show up
						},
						position: 'right',
						id: 'y-axis-time'
					}],
					xAxes: [{
						type: 'time',
						distribution: 'series',
						offset: true,
						ticks: {
							major: {
								enabled: true,
								fontStyle: 'bold'
							},
							source: 'data',
							autoSkip: true,
							autoSkipPadding: 75,
							maxRotation: 0,
							sampleSize: 100
						},
					}]
				}
			}
		};
		window.myLine = new Chart(ctx, config);
	};
</script>

<section class="section">
	<canvas id="tsab_graph" width="400" height="400"></canvas>
</section>
