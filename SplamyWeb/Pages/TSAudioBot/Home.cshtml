@page
@using SplamyWeb.Pages
@model TS3AudioBotModel
@{
	ViewData["Title"] = "TS3AudioBot";
	ViewData["Header"] = "";
	Layout = "~/Pages/_Layout.cshtml";
}

<section class="hero section">
	<div class="hero-body">
		<div class="container" style="text-align: center;">
			<h2 class="title heading is-1" style="color:white;">
				TS3Audiobot
			</h2>
			<h3 class="subtitle" style="color:white;">
				Open source selfhosted music bot and more...
			</h3>
		</div>
	</div>
</section>

<section class="section readblock">
	<div class="tile is-ancestor is-vertical">
		<div class="tile is-parent">
			<article class="tile is-child notification is-primary">
				<div class="level">
					<div class="level-item has-text-centered">
						<div>
							<p class="heading">Downloads</p>
							<p class="title">@Model.FormatMetric(Model.Downloads)</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p class="heading">Instances</p>
							<p class="title">@Model.FormatMetric(Model.RunningInstances)</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p class="heading">Bots</p>
							<p class="title">@Model.FormatMetric(Model.RunningBots)</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p class="heading">Playtime</p>
							<p class="title">@Model.FormatTime(Model.PlaybackTime + TimeSpan.FromDays(520))</p>
						</div>
					</div>
				</div>
			</article>
		</div>

		<div class="tile is-parent">
			<article class="tile is-child box">
				<p class="title">Downloads</p>
				<div class="content">
					<table class="table">
						@*<thead>
								<tr><th></th> <th>Master</th> <th>Develop</th></tr>
							</thead>*@
						<tbody>
							<tr>
								<td>.NET</td>
								<td>
									<a href="~/api/nightly/ts3ab/master/download"
									   download="TS3AudioBot.zip"
									   class="button is-primary is-rounded is-small">
										<span class="icon">
											<i class="mdi mdi-download mdi-18px"></i>
										</span>
										<span>Stable</span>
									</a>
								</td>
								<td>
									<em>Deprecated</em>
								</td>
							</tr>
							<tr>
								<td>dotnet core 2.2</td>
								<td>
									<a href="~/api/nightly/ts3ab/master_dotnet_core/download"
									   download="TS3AudioBot.zip"
									   class="button is-primary is-rounded is-small">
										<span class="icon">
											<i class="mdi mdi-download mdi-18px"></i>
										</span>
										<span>Stable</span>
									</a>
								</td>
								<td>
									<em>Deprecated</em>
								</td>
							</tr>
							<tr>
								<td>dotnet core 3.1</td>
								<td>
									<a href="~/api/nightly/ts3ab/master_dotnet_core_3_1_preview/download"
									   download="TS3AudioBot.zip"
									   class="button is-primary is-rounded is-small">
										<span class="icon">
											<i class="mdi mdi-download mdi-18px"></i>
										</span>
										<span>Stable</span>
									</a>
								</td>
								<td>
									<a href="~/api/nightly/ts3ab/develop/download"
									   download="TS3AudioBot.zip"
									   class="button is-primary is-rounded is-small">
										<span class="icon">
											<i class="mdi mdi-download mdi-18px"></i>
										</span>
										<span>Experimental</span>
									</a>
								</td>
							</tr>
						</tbody>
					</table>
					<br />
					For installation instructions follow our Readme: <a href="https://github.com/Splamy/TS3AudioBot#install" target="_blank">#Install</a>
				</div>
			</article>
		</div>

		<div class="tile">
			<div class="tile is-parent is-vertical">
				<article class="tile is-child notification is-primary">
					<p class="title">Wiki</p>
					<ul>
						<li><a href="https://github.com/Splamy/TS3AudioBot/wiki/CommandSystem" target="_blank">CommandSystem</a></li>
						<li><a href="https://github.com/Splamy/TS3AudioBot/wiki/Plugins" target="_blank">Plugins</a></li>
						<li><a href="https://github.com/Splamy/TS3AudioBot/wiki/WebAPI" target="_blank">Web API</a></li>
						<li><a href="https://github.com/Splamy/TS3AudioBot/wiki/Rights" target="_blank">Rights</a></li>
						<li><a href="https://github.com/Splamy/TS3AudioBot/wiki/FAQ" target="_blank">FAQ</a></li>
						<li><a href="https://github.com/Splamy/TS3AudioBot/wiki/Changelog" target="_blank">Changelog</a></li>
					</ul>
				</article>
			</div>
			<div class="tile is-parent">
				<article class="tile is-child notification is-info">
					<p class="title">Swagger/OpenApi</p>
					<p class="subtitle"><a href="https://tab.splamy.de/openapi/index.html"  target="_blank">Check out our live Swagger/OpenApi documentation</a></p>
					<figure class="image is-4by3">
						<img src="~/img/TS3AB_Swagger.png">
					</figure>
				</article>
			</div>
		</div>
	</div>
</section>
