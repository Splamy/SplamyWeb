@page
@model SplamyWeb.TabLanguagePacksModel
@{
	ViewData["Title"] = "TSAudioBot Language Packs";
	Layout = "~/Pages/_Layout.cshtml";
}

<p class="notification is-primary">
	<em>Want to help translate or improve translation?</em><br>
	Join us on <a href="https://www.transifex.com/respeak/ts3audiobot/">Transifex</a> to help translate<br>
	or in our <a href="https://gitter.im/TS3AudioBot/Lobby?utm_source=share-link&amp;utm_medium=link&amp;utm_campaign=share-link">Gitter</a> to discuss or ask anything!<br>
</p>

<p class="notification is-info">
	Note: The TSAudioBot will automatically download language extension packs when you select the language.
</p>

<table class="table" style="width:100%;">
	<tr>
		<th>Language</th>
		<th>Date</th>
		<th>Link</th>
	</tr>
	@foreach (var lang in this.Model.GetLanguages())
	{
		<tr>
			<td>@lang.GetCulture().DisplayName</td>
			<td>@lang.UploadTime</td>
			<td><a href="~/api/language/project/ts3ab/language/@lang.Language/dll" download="TS3AudioBot.resources.dll">Download</a></td>
		</tr>
	}
</table>
