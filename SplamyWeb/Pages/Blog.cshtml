@page
@model SplamyWeb.Pages.BlogModel
@{
	ViewData["Title"] = "Blog";
	ViewData["Header"] = "TS3AudioBlog";
	Layout = "~/Pages/_Layout.cshtml";
}

<div class="readblock">
	@foreach (var entry in this.Model.GetBlogs())
	{
		<article>
			<h2>@entry.Header</h2>
			<div>
				@*Admin Tools*@
				<a>Edit</a>
				<a>Delete</a>
			</div>
			<p>@entry.Summary</p>
			<p>@Html.Raw(entry.ContentHtml)</p>
			<hr />
			<label>Tags</label>
			<div>
				@foreach (var tag in entry.Tags)
				{
					<a>@tag</a>
				}
			</div>
			<a onclick="console.log('open :P')">Read more...</a>
		</article>
	}
</div>

