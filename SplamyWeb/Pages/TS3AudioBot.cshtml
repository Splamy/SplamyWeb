@page
@using SplamyWeb.Pages
@model TS3AudioBotModel
@{
	ViewData["Title"] = "TS3AudioBot";
	Layout = "_Layout";
}

<div>
	For the latest downloads see here: <a href="~/Nightly#ts3ab">Nightly</a>
</div>

<h2>Language Packs</h2>
<table class="dltable">
	<tr>
		<th>Language</th>
		<th>Date</th>
		<th>Link</th>
	</tr>
	@foreach (var lang in TS3AudioBotModel.GetLanguages())
	{
		<tr>
			<td>@lang.GetCulture().DisplayName</td>
			<td>@lang.UploadTime</td>
			<td><a href="~/api/language/project/ts3ab/language/@lang.Language/dll" download="TS3AudioBot.resources.dll" class="dllink">Download</a></td>
		</tr>
	}
</table>