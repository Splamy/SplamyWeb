@using System.Security.Claims
<!DOCTYPE html>
<html>
<head>
	<title>Splamy - @ViewData["Title"]</title>
	<link rel="stylesheet" href="style.css">
</head>
<body>
	<nav>
		<a class="navl" href="~/Index">Home</a>
		<a class="navl" href="~/Nightly">Nightly</a>
		<div class="navdrop">
			<a class="navl" href="~/TS3AudioBot">TS3AudioBot</a>
			<div class="navdrop-list">
				<a class="navl" href="~/Nightly#ts3ab">Nightly Builds</a>
				<a class="navl" href="http://tab.splamy.de" target="_blank">=&gt;Blog</a>
				<a class="navl" href="https://github.com/Splamy/TS3AudioBot" target="_blank">=&gt;Github</a>
			</div>
		</div>
		@if (User.Identity.Name != null)
		{
			<a class="navl" href="~/Admin">Admin</a>
			<a class="navuser" href="~/User">User: @Html.ViewContext.HttpContext.User.FindFirst(ClaimTypes.Name).Value</a>
			<form action="~/Account/Logout" method="POST">
				<label class="navl">
					Logout
					<input style="display: none" type="submit"/>
				</label>
			</form>
		}
		else
		{
			<a class="navl navuser" href="~/User">Login</a>
		}
	</nav>

	<h1>@(ViewData["Header"] ?? ViewData["Title"])</h1>

	<div id="content">
		@RenderBody()
	</div>
</body>
</html>
