@using System.Security.Claims
<!DOCTYPE html>
<html>
<head>
	<title>Splamy - @ViewData["Title"]</title>
	<link rel="stylesheet" href="~/lib/MaterialDesign-Webfont/css/materialdesignicons.min.css">
	<link rel="stylesheet" href="~/css/style.css">
	@*<link rel="stylesheet" href="~/css/style.less">*@
	@RenderSection("scripts", required: false)
</head>
<body>
	<nav>
		<a class="navl" href="~/Index">Home</a>
		<a class="navl" href="~/Nightly">Nightly</a>
		<div class="navdrop">
			<a class="navl" href="~/TSAudioBot/Home">TS3AudioBot</a>
			<div class="navdrop-list">
				<a class="navl" href="~/TSAudioBot/LanguagePacks">
					<span class="icon is-medium"><i class="mdi mdi-24px mdi-translate"></i></span>
					Language Packs
				</a>
				@*<a class="navl" href="~/TSAudioBot/Stats">
						<span class="icon is-medium"><i class="mdi mdi-24px mdi-counter"></i></span>
						Stats
					</a>*@
				<a class="navl" href="https://github.com/Splamy/TS3AudioBot" target="_blank">
					<span class="icon is-medium"><i class="mdi mdi-24px mdi-github-circle"></i></span>
					Github
				</a>
			</div>
		</div>
		<a class="navl" href="~/Impress">Impress &amp; Privacy</a>
		@if (User.Identity?.Name != null)
		{
			<a class="navl" href="~/Blog">Blog</a>
			@*<span class="icon is-medium"><i class="mdi mdi-24px mdi-calendar-text"></i></span>*@
			<div class="navdrop">
				<a class="navl" href="~/Admin/Hub">Admin</a>
				<div class="navdrop-list">
					<a class="navl" href="~/Admin/Log">Log</a>
					<a class="navl" href="~/Admin/Store">Store</a>
				</div>
			</div>
			<a class="navl navuser" href="~/User">User: @Html.ViewContext.HttpContext.User.FindFirst(ClaimTypes.Name)?.Value</a>
			<form action="~/Account/Logout" method="POST">
				<label class="navl">
					Logout
					<input style="display: none" type="submit" />
				</label>
			</form>
		}
		else
		{
			<a class="navl navuser" href="~/User">Login</a>
		}
	</nav>

	@if (ViewData["Header"]?.ToString() != "")
	{
		<h1 class="title">@(ViewData["Header"] ?? ViewData["Title"])</h1>
	}

	<section class="section">
		@RenderBody()
	</section>
</body>
</html>
