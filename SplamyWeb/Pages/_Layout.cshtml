@using System.Security.Claims
<!DOCTYPE html>
<html>
<head>
	<title>Splamy - @ViewData["Title"]</title>
	<link rel="stylesheet" href="style.css">
</head>
<body>
	<nav>
		<a class="navl" href="Index">Home</a>
		<a class="navl" href="Nightly">Nightly</a>
		<div class="navdrop">
			<span class="navl">TS3AudioBot</span>
			<div class="navdrop-list">
				<a class="navl" href="Nightly#ts3ab">Nightly Builds</a>
				<a class="navl" href="http://splamy.de/TS3AudioBot" target="_blank">=&gt;Blog</a>
				<a class="navl" href="https://github.com/Splamy/TS3AudioBot" target="_blank">=&gt;Github</a>
			</div>
		</div>
		@if (User.Identity.Name != null)
		{
			<a class="navl" href="Admin">Admin</a>
			<div class="navuser">User: @Html.ViewContext.HttpContext.User.FindFirst(ClaimTypes.Name).Value</div>
			<form action="/Account/Logout" method="POST">
				<label class="navl" style="cursor: pointer">
					Logout
					<input style="display: none" type="submit"/>
				</label>
			</form>
		}
		else
		{
			<a class="navl navuser" href="User">Login</a>
		}
	</nav>

	<h1>Splamy</h1>

	<div id="content">
		@RenderBody()
	</div>
</body>
</html>
