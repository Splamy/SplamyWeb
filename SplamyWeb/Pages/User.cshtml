@page
@using SplamyWeb.Pages
@model UserModel
@{
	ViewData["Title"] = "User";
	Layout = "~/Pages/_Layout.cshtml";
}

@if (User.Identity.Name == null)
{
	<div class="container" style="max-width:800px;">
		@foreach (var err in Html.ViewData.Model.ErrorLogin())
		{
			<div class="notification is-danger">@err</div>
		}

		<form action="~/Account/Login" method="POST">
			<div>
				<label><b>Username</b></label>
				<input type="text" placeholder="Enter Username" name="name" required>
				<br />
				<label><b>Password</b></label>
				<input type="password" placeholder="Enter Password" name="pass" required>
				<br />
				<button type="submit">Login</button>
				<input type="checkbox" checked="checked" name="remember" /> Remember me
			</div>
		</form>
	</div>
}
else
{
	<div class="container" style="max-width:800px;">
		<form action="~/Account/Update" method="POST" class="box">
			<input name="id" type="hidden" value="@Model.LoginData.Id">

			<div class="field">
				<label class="label">Username</label>
				<div class="control">
					<input name="name"
						   class="input"
						   type="text"
						   placeholder="Enter Username"
						   value="@Model.LoginData.Name"
						   disabled
						   required>
				</div>
			</div>

			<div class="field">
				<label class="label">Token</label>
				<div class="field has-addons">
					<div class="control is-expanded">
						<input name="token" class="input" type="password" placeholder="Token">
					</div>
					<div class="control">
						<button class="button is-warning">
							Refresh
						</button>
					</div>
				</div>
			</div>

			<div class="field">
				<div class="control">
					<button type="submit" class="button is-primary">Update</button>
				</div>
			</div>
		</form>


		<form action="~/Account/Update" method="POST" class="box">
			<input name="id" type="hidden" value="@Model.LoginData.Id">

			@foreach (var err in Html.ViewData.Model.ErrorChangePw())
			{
				<div class="notification is-danger">@err</div>
			}

			<div class="field">
				<label class="label">Current Password</label>
				<div class="control">
					<input name="pass_old" class="input" type="password" placeholder="Old Password">
				</div>
			</div>

			<div class="field">
				<label class="label">New Password</label>
				<div class="control">
					<input name="pass" class="input" type="password" placeholder="Enter Password">
				</div>
			</div>

			<div class="field">
				<label class="label">Confirm Password</label>
				<div class="control">
					<input class="input" type="password" placeholder="Confirm Password">
				</div>
			</div>

			<div class="field">
				<div class="control">
					<button type="submit" class="button is-primary">Update</button>
				</div>
			</div>
		</form>
	</div>
}
