@page
@using SplamyWeb
@using SplamyWeb.Pages
@model UserModel
@{
	ViewData["Title"] = "User";
	Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<h2>User</h2>

<div class="msg-error">@Html.ViewData.Model.Error()</div>

@if (User.Identity.Name == null)
{
	<form action="~/Account/Login" method="POST">
		<div>
			<label><b>Username</b></label>
			<input type="text" placeholder="Enter Username" name="name" required>
			<br />
			<label><b>Password</b></label>
			<input type="password" placeholder="Enter Password" name="pass" required>
			<br />
			<button type="submit">Login</button>
			<input type="checkbox" checked="checked" name="remember" /> Remember me
		</div>
	</form>
}
else
{
	<form action="~/Account/Update" method="POST">
		<div>
			<label><b>Username</b></label>
			<input type="text" placeholder="Enter Username" name="name" value="@Model.LoginData.Name" required>

			<label><b>Password</b></label>
			<input type="password" placeholder="Enter Password" name="pass">

			<label><b>Confirm Password</b></label>
			<input type="password" placeholder="Confirm Password" name="passconf">

			<label><b>Token</b></label>
			<input type="password" placeholder="Token" name="token">

			<button type="submit">Update</button>
		</div>
	</form>
}