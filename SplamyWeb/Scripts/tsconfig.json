{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "node",
		"noEmitOnError": true,
		"sourceMap": false,
		"removeComments": true,
		"declaration": false,
		"types": [ "svelte" ],
		"esModuleInterop": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	}
}
