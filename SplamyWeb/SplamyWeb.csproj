	  <Reference Include="RateMapSeveritySaber">
	    <HintPath>..\..\RateMapSeveritySaber\RateMapSeveritySaber\bin\Release\netstandard2.1\RateMapSeveritySaber.dll</HintPath>
	  </Reference>
	</ItemGroup>-->
</Project>
