<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>netcoreapp3.1</TargetFramework>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
		<CodeAnalysisRuleSet>SplamyWeb.ruleset</CodeAnalysisRuleSet>
		<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
		<LangVersion>8.0</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Migrations\20200512181156_InitialCreate.cs" />
	  <Compile Remove="Migrations\20200512181156_InitialCreate.Designer.cs" />
	  <Compile Remove="Migrations\20200613143441_InitialCreate.cs" />
	  <Compile Remove="Migrations\20200613143441_InitialCreate.Designer.cs" />
	  <Compile Remove="Migrations\20200613143933_InitialCreate.cs" />
	  <Compile Remove="Migrations\20200613143933_InitialCreate.Designer.cs" />
	  <Compile Remove="Migrations\20200613144636_InitialCreate.cs" />
	  <Compile Remove="Migrations\20200613144636_InitialCreate.Designer.cs" />
	  <Compile Remove="Migrations\20200613145708_initial.cs" />
	  <Compile Remove="Migrations\20200613145708_initial.Designer.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="15.0.5" />
		<PackageReference Include="dotless.Core" Version="1.6.7" />
		<PackageReference Include="LiteDB" Version="5.0.8" />
		<PackageReference Include="Markdig" Version="0.20.0" />
		<PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.7" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="3.1.5" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="3.1.5">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="3.1.5" />
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="3.1.3" />
		<PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="2.0.96" />
		<PackageReference Include="NLog" Version="4.7.2" />
		<PackageReference Include="NLog.Web.AspNetCore" Version="4.9.2" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="3.1.4" />
		<PackageReference Include="protobuf-net" Version="3.0.2" />
		<PackageReference Include="Splamy.Ed25519.Toolkit" Version="1.0.3" />
		<PackageReference Include="System.Net.Http.Json" Version="3.2.1" />
		<PackageReference Include="Utf8Json" Version="1.3.7" />
		<PackageReference Include="Splamy.RateMapSeveritySaber" Version="1.0.5" />
	</ItemGroup>

	<ItemGroup>
		<DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="compilerconfig.json" />
		<_ContentIncludedByDefault Remove="compilerconfig.json" />
	</ItemGroup>

	<!--<ItemGroup>
	  <Reference Include="RateMapSeveritySaber">
	    <HintPath>..\..\RateMapSeveritySaber\RateMapSeveritySaber\bin\Release\netstandard2.1\RateMapSeveritySaber.dll</HintPath>
	  </Reference>
	</ItemGroup>-->

	<ItemGroup>
		<TypeScriptCompile Include="wwwroot\ts\decl.d.ts" />
		<TypeScriptCompile Include="wwwroot\ts\nightly.ts" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\img\" />
	</ItemGroup>

	<PropertyGroup>
		<TypeScriptToolsVersion>3.8</TypeScriptToolsVersion>
		<TypeScriptTarget>es2018</TypeScriptTarget>
		<TypeScriptJSXEmit>None</TypeScriptJSXEmit>
		<TypeScriptModuleKind>es6</TypeScriptModuleKind>
		<TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
		<TypeScriptNoImplicitAny>False</TypeScriptNoImplicitAny>
		<TypeScriptRemoveComments>False</TypeScriptRemoveComments>
		<TypeScriptOutFile>wwwroot/ts/script.js</TypeScriptOutFile>
		<TypeScriptOutDir />
		<TypeScriptGeneratesDeclarations>False</TypeScriptGeneratesDeclarations>
		<TypeScriptNoEmitOnError>True</TypeScriptNoEmitOnError>
		<TypeScriptSourceMap>True</TypeScriptSourceMap>
		<TypeScriptMapRoot />
		<TypeScriptSourceRoot />
	</PropertyGroup>

</Project>
