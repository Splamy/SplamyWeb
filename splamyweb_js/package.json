{
	"name": "splamyweb-js",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --plugin=prettier-plugin-svelte --check . && eslint .",
		"format": "prettier --ignore-path .gitignore --plugin=prettier-plugin-svelte --write ."
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@types/prismjs": "1.26.6",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "17.9.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"sass": "1.102.0",
		"svelte": "5.56.8",
		"svelte-check": "4.7.5",
		"svelte-preprocess": "6.0.5",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.66.0",
		"vite": "8.2.1"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/fira-mono": "5.3.0",
		"@mdi/js": "7.4.47",
		"@microsoft/signalr": "10.0.11",
		"bulma": "0.9.4",
		"chart.js": "4.5.1",
		"chartjs-adapter-moment": "1.0.1",
		"moment": "2.30.1",
		"monaco-editor": "0.56.0",
		"prismjs": "1.30.0",
		"qrious": "4.0.2",
		"svelte-tiny-virtual-list": "4.0.0-rc.2",
		"sweetalert": "2.1.2"
	}
}
